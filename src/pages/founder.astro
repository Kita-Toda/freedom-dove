---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import MediaCard from '../components/ui/MediaCard';
import Icon from '../components/Icon.astro';
import soniaPortrait from '../images/Sonia_Qutami1.jpg';
import soniaSpeaking from '../images/Sonia_Qutami2.jpg';
---

<Layout title="Founder — Sonia Qutami | Unchained">
  <div class="min-h-screen bg-gradient-to-b from-black to-charcoal py-32 px-4 md:px-12">
    <!-- Hero Section -->
    <section class="mb-32">
      <div class="max-w-6xl mx-auto">
        <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
          Meet Our Founder
        </div>
        <h1 class="text-5xl sm:text-6xl md:text-8xl font-black text-cream leading-tight mb-8" style="letter-spacing: -0.02em;">
          Sonia Qutami
        </h1>
        <p class="text-2xl text-cream/80 max-w-3xl mb-12 leading-relaxed">
          Mother, foster mother, filmmaker and advocate—funding frontline rescue and giving survivors a place to be heard.
        </p>
      </div>
    </section>

    <!-- Image Gallery Section -->
    <section class="mb-32 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        <!-- Image 1 with Creative Card -->
        <div class="group">
          <div class="relative overflow-hidden rounded-3xl border-2 border-gold/30 hover:border-gold/60 transition-all duration-300 h-full">
            {/* Below the fold, so lazy. Loading these two eagerly at full size
                saturated the connection and pushed this page's LCP (the hero
                paragraph above) out to ~11.5s on throttled mobile. */}
            <Image
              src={soniaPortrait}
              alt="Sonia Qutami - Founder of Unchained"
              widths={[400, 512, 800, 1024]}
              sizes="(min-width: 768px) 512px, 100vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute bottom-0 left-0 right-0 p-8">
                <p class="text-cream text-lg font-semibold">Visionary Leadership</p>
                <p class="text-cream/70 text-sm">Shaping the Future of Human Rights</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Image 2 with Creative Card -->
        <div class="group">
          <div class="relative overflow-hidden rounded-3xl border-2 border-mauve/30 hover:border-mauve/60 transition-all duration-300 h-full">
            <Image
              src={soniaSpeaking}
              alt="Sonia Qutami Speaking At Event"
              widths={[400, 512, 800, 1024]}
              sizes="(min-width: 768px) 512px, 100vw"
              format="webp"
              quality={80}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="absolute bottom-0 left-0 right-0 p-8">
                <p class="text-cream text-lg font-semibold">Global Advocacy</p>
                <p class="text-cream/70 text-sm">Speaking for Survivors in Australia and Beyond</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Biography Section -->
    <section class="mb-32 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
        <!-- Main Bio -->
        <div class="md:col-span-2">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-cream mb-8">Her Story</h2>

          <div class="space-y-6 text-cream/80 text-lg leading-relaxed">
            <p>
              Sonia Qutami is a mother of three, including one child with Down syndrome, and a dedicated foster mother. Her life has been shaped by a deep Christian faith and an unwavering commitment to standing with the vulnerable.
            </p>

            <p>
              As a film producer and director, Sonia recently completed a proof of concept titled <em>Proverbs 22:6</em>—a powerful story confronting child trafficking, human exploitation, government corruption and the hope found in Jesus Christ.
            </p>

            <p>
              Sonia is unapologetic about her faith and believes that the battle against exploitation is not only physical but also spiritual. She is committed to being the hands and feet of Jesus, bringing light into some of the darkest places in our world.
            </p>

            <p>
              Her film has been submitted to Angel Studios for consideration for crowdfunding—the same platform that helped launch <em>The Chosen</em> to a global audience.
            </p>

            <p>
              Sonia's commitment extends far beyond filmmaking. Several years ago, she personally funded a rescue operation in the Philippines that resulted in the rescue of 19 children, some as young as five years old. That experience strengthened her resolve to do more.
            </p>

            <p>
              Over the following years, Sonia organised four anti-human trafficking fundraising galas, raising more than $170,000 to support rescue efforts that contributed to the freedom of 50 children from exploitation, with another raid to come.
            </p>

            <p>
              On 18 July 2026, Sonia hosted the fourth Unchained Gala, inspired by Psalm 107:14:
            </p>

            <blockquote class="border-l-2 border-gold/50 pl-6 italic text-cream/90">
              "He brought them out of darkness, the utter darkness, and broke away their chains."
            </blockquote>

            <p>
              The event brought together respected advocates including Barbara and Michael O'Neill, two frontline rescue operators from Sydney and Melbourne, former Rescue Squad detective Gary Raymond and, for the first time, courageous Australian survivors connected with the Remembered Australians (formerly known as the Forgotten Australians). These survivors shared their stories of being trafficked, abused, bought, sold and exploited in Australia, helping ensure their voices were finally heard.
            </p>

            <p>
              Sonia believes survivors deserve not only justice but also a platform to speak, heal and be remembered.
            </p>

            <p>
              She has proudly supported Destiny Rescue, the organisation that carried out the rescue operation she funded in the Philippines, helping rescue children from sexual exploitation and human trafficking.
            </p>

            <p>
              Sonia also serves as an ambassador for Freedom for Humanity, founded by Anna Ruth, an organisation dedicated to restoring survivors through education, apprenticeships, scholarships and long-term community reintegration.
            </p>

            <p>
              Sonia is also part of the Forever Freedom Movement, founded by Anthony Harrison. Through this initiative, she is supporting the launch of One Million Voices for the Innocent, a global awareness campaign encouraging people to use their voices to protect children and stand against exploitation.
            </p>

            <p>
              As co-host of the launch event on 26 August, Sonia will join Anthony Harrison in presenting an event that will be livestreamed to a venue in Melbourne and broadcast internationally, expanding its reach to audiences around the world.
            </p>

            <p>
              The initiative also seeks to bring light into the gaming world—a multi-trillion-dollar global industry where children connect every day. Recognising that online gaming can be a space where grooming and exploitation occur, the campaign aims to educate young people, parents and the wider community about online safety, warning signs and red flags. Through awareness, education and practical conversations, One Million Voices for the Innocent is committed to helping create safer online environments and empowering children and families to recognise potential dangers before harm occurs.
            </p>

            <p>
              Sonia also ran with the Heart Party in the 2025 federal election for the New South Wales Senate with Michael O'Neill. In 2027, she will be running in the state election for the Libertarians in the Leppington area, and she may also be running for council. This just goes to show her strong determination to bring justice and to see God-fearing men and women restored to positions of leadership and power.
            </p>

            <p>
              Today, Sonia continues to work alongside organisations, law enforcement professionals, survivors, advocates and community leaders who share one vision: ending human trafficking and protecting the innocent.
            </p>

            <p>
              Looking ahead, Sonia is committed to expanding Unchained's work throughout Australia. While supporting rescue efforts around the world remains important, she believes Australia must also confront the exploitation happening within its own borders.
            </p>

            <p>
              This is more than Sonia's mission—it is her calling. Through faith, action and collaboration, she is determined to help break chains, restore lives and ensure every child has the opportunity to live in freedom.
            </p>
          </div>
        </div>

        {/* self-start + sticky: the bio beside this column is now many times
            taller than three cards, so without it the stats scroll away early
            and leave a long empty gutter. Grid items stretch by default, which
            silently defeats position:sticky — hence self-start. */}
        <div class="space-y-8 self-start md:sticky md:top-24">
          <div class="bg-charcoal/50 border-2 border-gold/30 rounded-2xl p-8 hover:border-gold/60 transition-colors duration-300">
            <div class="text-4xl font-black text-gold mb-3">19</div>
            <div class="text-cream font-bold mb-2">Children Rescued</div>
            <div class="text-cream/70 text-sm">In the Philippines Operation She Funded</div>
          </div>

          <div class="bg-charcoal/50 border-2 border-mauve/30 rounded-2xl p-8 hover:border-mauve/60 transition-colors duration-300">
            <div class="text-4xl font-black text-mauve-light mb-3">$170K+</div>
            <div class="text-cream font-bold mb-2">Raised</div>
            <div class="text-cream/70 text-sm">Across Four Anti-Trafficking Galas</div>
          </div>

          <div class="bg-charcoal/50 border-2 border-gold-light/30 rounded-2xl p-8 hover:border-gold-light/60 transition-colors duration-300">
            <div class="text-4xl font-black text-gold-light mb-3">50</div>
            <div class="text-cream font-bold mb-2">Children Freed</div>
            <div class="text-cream/70 text-sm">Through the Rescue Efforts She Supported</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Impact Pillars -->
    <section class="mb-32 max-w-6xl mx-auto border-t border-gold/20 pt-20">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-cream mb-16 text-center">How Sonia Works</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="group relative bg-charcoal/50 border-2 border-gold/30 rounded-2xl p-8 hover:border-gold/60 hover:bg-charcoal/70 transition-all duration-300">
          <Icon name="sparkles" class="w-12 h-12 mb-6 text-gold group-hover:scale-110 transition-transform duration-300" />
          <h3 class="text-xl font-bold text-gold mb-4">Faith First</h3>
          <p class="text-cream/70">A calling to be the hands and feet of Jesus in the darkest places</p>
        </div>

        <div class="group relative bg-charcoal/50 border-2 border-mauve/30 rounded-2xl p-8 hover:border-mauve/60 hover:bg-charcoal/70 transition-all duration-300">
          <Icon name="shield" class="w-12 h-12 mb-6 text-mauve-light group-hover:scale-110 transition-transform duration-300" />
          <h3 class="text-xl font-bold text-mauve-light mb-4">Funding Rescue</h3>
          <p class="text-cream/70">Galas and giving that put resources directly behind frontline operations</p>
        </div>

        <div class="group relative bg-charcoal/50 border-2 border-gold-light/30 rounded-2xl p-8 hover:border-gold-light/60 hover:bg-charcoal/70 transition-all duration-300">
          <Icon name="megaphone" class="w-12 h-12 mb-6 text-gold-light group-hover:scale-110 transition-transform duration-300" />
          <h3 class="text-xl font-bold text-gold-light mb-4">Storytelling</h3>
          <p class="text-cream/70">Film and campaigns that confront exploitation and point to hope</p>
        </div>

        <div class="group relative bg-charcoal/50 border-2 border-cream/30 rounded-2xl p-8 hover:border-cream/60 hover:bg-charcoal/70 transition-all duration-300">
          <Icon name="hand-raised" class="w-12 h-12 mb-6 text-cream group-hover:scale-110 transition-transform duration-300" />
          <h3 class="text-xl font-bold text-cream mb-4">Survivor Voices</h3>
          <p class="text-cream/70">A platform for survivors to speak, heal and be remembered</p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-cream mb-8">Join Sonia's Movement</h2>
      <p class="text-lg text-cream/80 mb-12 max-w-2xl mx-auto">
        Every action contributes to freedom. Whether you donate, volunteer, advocate, or partner with us—you're part of something transformative.
      </p>
      <div class="flex flex-col md:flex-row gap-6 justify-center">
        <a href="/get-involved" class="px-12 py-5 bg-gold text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px] shadow-lg">
          Get Involved Today
        </a>
        <a href="/about" class="px-12 py-5 border-2 border-gold text-gold font-bold rounded-full hover:bg-gold hover:text-black transition-all duration-200 text-sm tracking-[0.75px]">
          Learn About Unchained
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  section {
    scroll-behavior: smooth;
  }
</style>
