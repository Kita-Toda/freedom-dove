---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Get Involved — Unchained">
  <div class="min-h-screen bg-gradient-to-b from-black to-charcoal py-32 px-4 md:px-12">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-20">
        <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
          Take Action
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-black text-cream leading-tight mb-8" style="letter-spacing: -0.02em;">
          Get Involved
        </h1>
        <p class="text-xl text-cream/80 max-w-2xl">
          There are many ways to join the movement for freedom. Whether you have resources, expertise, or passion—we need you.
        </p>
      </div>

      <!-- Action Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-20">
        <!-- Volunteer -->
        <div class="group">
          <div class="relative bg-charcoal/50 border border-mauve/30 rounded-3xl p-12 hover:border-mauve/60 transition-colors duration-300 h-full">
            <Icon name="users" class="w-12 h-12 mb-6 text-mauve-light group-hover:scale-110 transition-transform duration-300" />
            <h2 class="text-3xl font-bold text-mauve-light mb-4">Volunteer</h2>
            <p class="text-cream/80 leading-relaxed mb-8">
              Contribute your professional skills: legal expertise, software development, mental health counseling, job placement services, or grant writing.
            </p>
            <ul class="space-y-3 text-cream/70 text-sm mb-8">
              <li class="flex items-start">
                <span class="text-mauve-light mr-3">✓</span>
                <span>Remote or in-person opportunities</span>
              </li>
              <li class="flex items-start">
                <span class="text-mauve-light mr-3">✓</span>
                <span>Flexible time commitment</span>
              </li>
              <li class="flex items-start">
                <span class="text-mauve-light mr-3">✓</span>
                <span>Monthly skill-share workshops</span>
              </li>
            </ul>
            <a href="https://volunteer.unchained.org" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-mauve text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px]">
              Apply to Volunteer
            </a>
          </div>
        </div>

        <!-- Partner -->
        <div class="group">
          <div class="relative bg-charcoal/50 border border-gold-light/30 rounded-3xl p-12 hover:border-gold-light/60 transition-colors duration-300 h-full">
            <Icon name="globe" class="w-12 h-12 mb-6 text-gold-light group-hover:scale-110 transition-transform duration-300" />
            <h2 class="text-3xl font-bold text-gold-light mb-4">Partner With Us</h2>
            <p class="text-cream/80 leading-relaxed mb-8">
              Organisations, businesses and community groups partner with us on events, awareness campaigns, and support for survivors.
            </p>
            <ul class="space-y-3 text-cream/70 text-sm mb-8">
              <li class="flex items-start">
                <span class="text-gold-light mr-3">✓</span>
                <span>Sponsor a gala or awareness event</span>
              </li>
              <li class="flex items-start">
                <span class="text-gold-light mr-3">✓</span>
                <span>Bring our education work to your community</span>
              </li>
              <li class="flex items-start">
                <span class="text-gold-light mr-3">✓</span>
                <span>Align your impact with ours</span>
              </li>
            </ul>
            <a href="mailto:info@unchained.fund" class="inline-block px-8 py-3 bg-gold-light text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px]">
              Get in Touch
            </a>
          </div>
        </div>

        <!-- Advocate -->
        <div class="group">
          <div class="relative bg-charcoal/50 border border-cream/30 rounded-3xl p-12 hover:border-cream/60 transition-colors duration-300 h-full">
            <Icon name="megaphone" class="w-12 h-12 mb-6 text-cream group-hover:scale-110 transition-transform duration-300" />
            <h2 class="text-3xl font-bold text-cream mb-4">Advocate</h2>
            <p class="text-cream/80 leading-relaxed mb-8">
              Use your platform, voice, or influence to amplify survivor stories and demand policy change. Sign petitions, share resources, contact representatives.
            </p>
            <ul class="space-y-3 text-cream/70 text-sm mb-8">
              <li class="flex items-start">
                <span class="text-cream mr-3">✓</span>
                <span>Join our advocacy network</span>
              </li>
              <li class="flex items-start">
                <span class="text-cream mr-3">✓</span>
                <span>Learn the warning signs of grooming</span>
              </li>
              <li class="flex items-start">
                <span class="text-cream mr-3">✓</span>
                <span>Lend your voice to One Million Voices for the Innocent</span>
              </li>
            </ul>
            <a href="https://advocate.unchained.org" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 border-2 border-cream text-cream font-bold rounded-full hover:bg-cream hover:text-black transition-all duration-200 text-sm tracking-[0.75px]">
              Join the Network
            </a>
          </div>
        </div>

        {/* Donate sits last on purpose: bottom-right of the 2-col grid on
            desktop, and last in the stack once the grid collapses to one
            column on mobile. Kept in DOM order rather than nudged with CSS
            `order` so the reading order matches the visual one. */}
        <!-- Donate -->
        <div class="group">
          <div class="relative bg-charcoal/50 border border-gold/30 rounded-3xl p-12 hover:border-gold/60 transition-colors duration-300 h-full">
            <Icon name="donate" class="w-12 h-12 mb-6 text-gold group-hover:scale-110 transition-transform duration-300" />
            <h2 class="text-3xl font-bold text-gold mb-4">Donate</h2>
            <p class="text-cream/80 leading-relaxed mb-8">
              Your giving goes to the frontline rescue partners we work with—the organisations that bring children out of exploitation and help them rebuild.
            </p>
            <ul class="space-y-3 text-cream/70 text-sm mb-8">
              <li class="flex items-start">
                <span class="text-gold mr-3">✓</span>
                <span>One-off or regular giving</span>
              </li>
              <li class="flex items-start">
                <span class="text-gold mr-3">✓</span>
                <span>Funds named rescue partners</span>
              </li>
              <li class="flex items-start">
                <span class="text-gold mr-3">✓</span>
                <span>We tell you what your giving made possible</span>
              </li>
            </ul>
            <a href="https://donate.unchained.org" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-gold text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px]">
              Donate Now
            </a>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="border-t border-gold/20 pt-20">
        <h2 class="text-4xl font-bold text-cream mb-12">Frequently Asked Questions</h2>

        <div class="space-y-6">
          <div class="faq-item border-b border-gold/10 pb-6">
            <button type="button" class="faq-toggle w-full flex items-center justify-between text-left hover:text-gold transition min-h-11 py-2" aria-expanded="false" aria-controls="faq-answer-1">
              <h3 class="text-lg font-bold text-cream">Where does my donation actually go?</h3>
              <span class="faq-icon shrink-0 ml-4 text-gold text-2xl transition-transform duration-200" aria-hidden="true">+</span>
            </button>
            <p id="faq-answer-1" class="text-cream/80 leading-relaxed mt-4 hidden">
              To the frontline rescue partners we work with. Our founder personally funded the operation carried out by Destiny Rescue in the Philippines that brought nineteen children home, and the funds raised at our galas go to work of that kind.
            </p>
          </div>

          <div class="faq-item border-b border-gold/10 pb-6">
            <button type="button" class="faq-toggle w-full flex items-center justify-between text-left hover:text-gold transition min-h-11 py-2" aria-expanded="false" aria-controls="faq-answer-2">
              <h3 class="text-lg font-bold text-cream">Do volunteers need prior experience?</h3>
              <span class="faq-icon shrink-0 ml-4 text-gold text-2xl transition-transform duration-200" aria-hidden="true">+</span>
            </button>
            <p id="faq-answer-2" class="text-cream/80 leading-relaxed mt-4 hidden">
              We welcome people at all skill levels. We provide training for all volunteer roles and match you to opportunities that fit your background.
            </p>
          </div>

          <div class="faq-item border-b border-gold/10 pb-6">
            <button type="button" class="faq-toggle w-full flex items-center justify-between text-left hover:text-gold transition min-h-11 py-2" aria-expanded="false" aria-controls="faq-answer-3">
              <h3 class="text-lg font-bold text-cream">Which organisations do you support?</h3>
              <span class="faq-icon shrink-0 ml-4 text-gold text-2xl transition-transform duration-200" aria-hidden="true">+</span>
            </button>
            <p id="faq-answer-3" class="text-cream/80 leading-relaxed mt-4 hidden">
              We have supported Destiny Rescue, which rescues children from sexual exploitation and trafficking. Our founder is an ambassador for Freedom for Humanity, which restores survivors through education, apprenticeships and long-term reintegration, and part of the Forever Freedom Movement.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  // Accessible FAQ accordion: click / keyboard to toggle, works on touch.
  document.querySelectorAll<HTMLButtonElement>('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      const answer = document.getElementById(btn.getAttribute('aria-controls') || '');
      answer?.classList.toggle('hidden', expanded);
      const icon = btn.querySelector<HTMLElement>('.faq-icon');
      if (icon) icon.style.transform = expanded ? '' : 'rotate(45deg)';
    });
  });
</script>
