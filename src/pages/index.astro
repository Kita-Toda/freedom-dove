---
import Layout from '../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import DoveHero from '../components/ui/DoveHero';
import Icon from '../components/Icon.astro';
import doveDesktop from '../images/dove_eye_fixed.png';
// Derived from mob_dove.jpeg: that file is an opaque JPEG, so dropping it in
// as-is painted a black rectangle over the beams. mix-blend-screen does not
// help — the hero's z-10 creates a stacking context, so the blend never reaches
// the canvas behind it. mob_dove_cutout.png is the same artwork with its black
// field keyed out to alpha (luminance as the alpha channel) and cropped to the
// bird. Regenerate it if mob_dove.jpeg is ever replaced.
import doveMobile from '../images/mob_dove_cutout.png';

// getImage + a hand-written <picture> rather than two <Image>s behind
// hidden/md:block: browsers still download images that are display:none, so the
// class-swap approach fetched both artworks on every viewport. <source media>
// makes the browser choose exactly one.
const doveMobileImg = await getImage({
  src: doveMobile, format: 'webp', quality: 82, widths: [320, 480, 640],
});
const doveDesktopImg = await getImage({
  src: doveDesktop, format: 'webp', quality: 85, widths: [420, 602, 840],
});
---

<Layout title="Unchained — End Human Trafficking">
  <div id="main" class="relative z-10">
    <!-- Hero Section with Dove Component -->
    {/* client:idle, not client:load. Everything above the fold here (dove,
        mission text, gradients, scroll prompt) is server-rendered, so deferring
        hydration costs nothing visually — only the beams canvas needs JS and it
        simply fades in a beat later. Measured over 3 runs: FCP 2.0s -> 1.5s,
        LCP 2.9s -> 1.6s, Lighthouse 93 -> 97.

        The dove is passed in as a slot rather than imported inside DoveHero,
        because astro:assets (and therefore WebP + srcset) is unavailable inside
        a React component. Swapping the two artworks with hidden/md:block keeps
        it pure CSS — no hydration, no matchMedia, and each viewport downloads
        only the image it shows. */}
    <DoveHero client:idle missionText="For The Forgotten. For The Voiceless. For A World Without Chains.">
      <picture>
        <source
          media="(min-width: 768px)"
          srcset={doveDesktopImg.srcSet.attribute}
          sizes="38vw"
          width={doveDesktopImg.attributes.width}
          height={doveDesktopImg.attributes.height}
        />
        <img
          src={doveMobileImg.src}
          srcset={doveMobileImg.srcSet.attribute}
          sizes="62vw"
          width={doveMobileImg.attributes.width}
          height={doveMobileImg.attributes.height}
          alt="A dove in flight carrying an olive branch"
          loading="eager"
          fetchpriority="high"
          class="w-[72%] max-w-sm md:w-auto md:max-w-none md:h-full max-h-full object-contain"
        />
      </picture>
    </DoveHero>

    <!-- Mission Section -->
    <section class="min-h-screen py-32 px-4 md:px-12 bg-gradient-to-b from-black to-charcoal relative z-20">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
          <div class="scroll-reveal">
            <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
              Our Mission
            </div>
            <h2 class="text-4xl sm:text-5xl md:text-7xl font-black text-cream leading-tight mb-8" style="letter-spacing: -0.02em;">
              Breaking Chains
            </h2>
            <p class="text-xl text-cream/80 leading-relaxed mb-8 max-w-xl">
              We believe in the fundamental right to freedom for all human beings. We fund frontline rescue, give survivors a platform to be heard, and work to end exploitation both overseas and here in Australia.
            </p>
            <div class="flex gap-4">
              <a href="#action" class="px-8 py-4 bg-gold text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px]">
                Get Involved
              </a>
              <a href="#impact" class="px-8 py-4 border-2 border-gold text-gold font-bold rounded-full hover:bg-gold hover:text-black transition-all duration-200 text-sm tracking-[0.75px]">
                Learn More
              </a>
            </div>
          </div>

          <div class="scroll-reveal delay-200">
            <div class="relative">
              <div class="absolute -inset-4 bg-gradient-to-r from-gold to-mauve opacity-20 blur-2xl rounded-3xl"></div>
              <div class="relative bg-charcoal border-2 border-gold/30 rounded-3xl p-12 backdrop-blur-sm">
                <div class="text-center">
                  <div class="text-4xl sm:text-5xl font-black text-gold mb-2">49.6M</div>
                  <div class="text-cream/80 text-sm tracking-wide">In Modern Slavery Today</div>
                  <div class="text-cream/50 text-xs mt-3 font-light">ILO & Walk Free Global Estimates</div>
                  <div class="h-1 w-16 bg-gradient-to-r from-gold to-mauve mx-auto mt-6"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Impact Section -->
    <section id="impact" class="min-h-screen py-32 px-4 md:px-12 relative z-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
          <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6 scroll-reveal">
            Global Impact
          </div>
          <h2 class="text-4xl sm:text-5xl md:text-7xl font-black text-cream leading-tight scroll-reveal" style="letter-spacing: -0.02em;">
            The Work So Far
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            {
              number: '50',
              label: 'Children Freed',
              desc: 'Through the rescue efforts we support',
              borderColor: 'border-gold/40',
              accentColor: 'text-gold',
              glowColor: 'from-gold/25 to-gold/10',
            },
            {
              number: '$170K+',
              label: 'Raised',
              desc: 'Across four anti-trafficking galas',
              borderColor: 'border-mauve/40',
              accentColor: 'text-mauve-light',
              glowColor: 'from-mauve/25 to-mauve/10',
            },
            {
              number: '19',
              label: 'Rescued in the Philippines',
              desc: 'In a single operation we funded',
              borderColor: 'border-gold-light/40',
              accentColor: 'text-gold-light',
              glowColor: 'from-gold-light/25 to-gold/10',
            },
          ].map((stat, i) => (
            <div key={i} class="scroll-reveal" style={`--delay: ${i * 100}ms`}>
              <div class="relative group">
                <div class={`absolute -inset-2 bg-gradient-to-r ${stat.glowColor} rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-xl`}></div>
                <div class={`relative bg-charcoal/50 border ${stat.borderColor} rounded-2xl p-8 backdrop-blur-sm hover:border-opacity-100 transition-colors duration-300`}>
                  <div class={`text-4xl sm:text-5xl font-black ${stat.accentColor} mb-3`}>{stat.number}</div>
                  <div class="text-lg font-bold text-cream mb-2">{stat.label}</div>
                  <p class="text-cream/70 text-sm">{stat.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stories Section -->
    <section class="min-h-screen py-32 px-4 md:px-12 bg-gradient-to-b from-charcoal to-black relative z-20">
      <div class="max-w-6xl mx-auto">
        <div class="mb-20">
          <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6 scroll-reveal">
            Real Stories
          </div>
          <h2 class="text-4xl sm:text-5xl md:text-7xl font-black text-cream leading-tight scroll-reveal" style="letter-spacing: -0.02em;">
            Voices of Hope
          </h2>
        </div>

        <div class="space-y-16">
          {[
            {
              title: 'Nineteen Children Home',
              desc: 'Our founder personally funded a rescue operation carried out by Destiny Rescue in the Philippines. Nineteen children were brought out of exploitation—some of them as young as five years old.',
              region: 'Philippines',
            },
            {
              title: 'Voices Finally Heard',
              desc: 'At the fourth Unchained Gala in July 2026, survivors connected with the Remembered Australians shared their stories of being trafficked, abused, bought and sold in Australia—alongside frontline rescue operators and former Rescue Squad detective Gary Raymond.',
              region: 'Australia',
            },
            {
              title: 'One Million Voices for the Innocent',
              desc: 'A global awareness campaign launching with the Forever Freedom Movement, encouraging people to use their voices to protect children—including in the gaming world, where grooming and exploitation too often go unseen.',
              region: 'Global',
            },
          ].map((story, i) => (
            <div key={i} class="scroll-reveal" style={`--delay: ${i * 150}ms`}>
              <div class="group relative">
                <div class="absolute -inset-4 bg-gradient-to-r from-gold/10 to-mauve/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur-lg"></div>
                <div class="relative bg-charcoal border border-gold/20 rounded-2xl p-8 md:p-12 group-hover:border-gold/50 transition-colors duration-300">
                  <div class="flex items-start justify-between mb-6">
                    <h3 class="text-2xl md:text-3xl font-bold text-gold">{story.title}</h3>
                    <span class="text-cream/60 text-sm tracking-wide font-semibold">{story.region}</span>
                  </div>
                  <p class="text-lg text-cream/80 leading-relaxed">{story.desc}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section id="action" class="min-h-screen py-32 px-4 md:px-12 flex items-center justify-center relative z-20">
      <div class="max-w-4xl mx-auto text-center">
        <div class="scroll-reveal mb-8">
          <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
            Join the Movement
          </div>
          <h2 class="text-5xl sm:text-6xl md:text-8xl font-black text-cream leading-tight mb-8" style="letter-spacing: -0.02em;">
            Every Voice Matters
          </h2>
          <p class="text-xl text-cream/80 max-w-2xl mx-auto mb-12">
            Whether you're an advocate, survivor, organization, or concerned citizen—there's a role for you in this movement toward universal freedom.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16 scroll-reveal">
          {[
            {
              title: 'Donate',
              desc: 'Financial support funds direct services to survivors and advocacy programs.',
              icon: 'donate',
              color: 'border-gold',
              accentColor: 'text-gold'
            },
            {
              title: 'Volunteer',
              desc: 'Share your professional expertise in legal, tech, or social services.',
              icon: 'users',
              color: 'border-mauve',
              accentColor: 'text-mauve-light'
            },
            {
              title: 'Partner',
              desc: 'Collaborate on research, policy, or direct survivor support programs.',
              icon: 'globe',
              color: 'border-gold-light',
              accentColor: 'text-gold-light'
            },
          ].map((item) => (
            <div key={item.title} class={`relative group bg-charcoal/50 border ${item.color}/40 rounded-2xl p-8 hover:border-opacity-100 transition-all duration-300 backdrop-blur-sm hover:shadow-lg hover:shadow-gold/20`}>
              <Icon name={item.icon} class={`w-12 h-12 mb-4 ${item.accentColor} group-hover:scale-110 transition-transform duration-300`} />
              <h3 class={`text-2xl font-bold ${item.accentColor} mb-2`}>{item.title}</h3>
              <p class="text-cream/70 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="flex flex-col md:flex-row gap-6 justify-center scroll-reveal">
          <a href="/get-involved" class="px-12 py-5 bg-gold text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px] shadow-lg hover:shadow-xl text-center">
            Take Action Now →
          </a>
          <a href="/about" class="px-12 py-5 border-2 border-gold text-gold font-bold rounded-full hover:bg-gold hover:text-black transition-all duration-200 text-sm tracking-[0.75px] text-center">
            Learn More →
          </a>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black border-t border-gold/20 py-16 px-4 relative z-20">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
          <div>
            <h3 class="text-gold font-bold mb-4 tracking-wide">Unchained</h3>
            <p class="text-cream/60 text-sm">Ending human trafficking and modern slavery worldwide.</p>
          </div>
          <div>
            <h4 class="text-cream font-bold mb-4 tracking-wide text-xs">Site</h4>
            <ul class="space-y-2 text-sm text-cream/60">
              <li><a href="/#impact" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Our Impact</a></li>
              <li><a href="/founder" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Our Founder</a></li>
              <li><a href="/gallery" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Gallery</a></li>
              <li><a href="/get-involved" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Get Involved</a></li>
              <li><a href="/about" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">About Us</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-cream font-bold mb-4 tracking-wide text-xs">Follow</h4>
            <ul class="space-y-2 text-sm text-cream/60">
              <li><a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Twitter →</a></li>
              <li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Instagram →</a></li>
              <li><a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">LinkedIn →</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-cream font-bold mb-4 tracking-wide text-xs">Legal</h4>
            <ul class="space-y-2 text-sm text-cream/60">
              <li><a href="/privacy" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Privacy Policy</a></li>
              <li><a href="/terms" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">Terms of Service</a></li>
              <li><a href="mailto:info@unchained.fund" class="hover:text-gold transition inline-flex items-center min-h-11 md:min-h-0">info@unchained.fund</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gold/20 pt-8 text-center text-cream/60 text-sm">
          <p>&copy; 2026 Unchained. All rights reserved. Built with purpose.</p>
          <p class="mt-4 text-xs text-cream/50">
            Made by <a href="https://www.sprucemysite.com.au" target="_blank" rel="noopener noreferrer" class="text-gold hover:text-gold-light transition">SpruceMySite</a>
          </p>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(32px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  .animate-bounce {
    animation: bounce 2s infinite;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translateY(32px);
    animation: fadeInUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) both;
    --delay: 0ms;
    animation-delay: var(--delay);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal,
    .animate-fade-in-up,
    .animate-bounce {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Button states */
  button, a.button-like {
    transition: transform 200ms var(--ease-out), box-shadow 200ms var(--ease-out);
  }

  button:active, a.button-like:active {
    transform: scale(0.97);
  }

  button:focus-visible, a.button-like:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Scroll-triggered reveals
  document.querySelectorAll('.scroll-reveal').forEach((element) => {
    gsap.to(element, {
      scrollTrigger: {
        trigger: element,
        start: 'top 80%',
        end: 'top 20%',
        toggleActions: 'play none none reverse',
      },
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'cubic-bezier(0.23, 1, 0.32, 1)',
    });
  });

  // Parallax effect on sections
  gsap.utils.toArray<HTMLElement>('section').forEach((section) => {
    gsap.to(section, {
      scrollTrigger: {
        trigger: section,
        start: 'top center',
        end: 'bottom center',
        markers: false,
      },
      y: (i, target) => {
        return window.innerHeight * 0.05;
      },
      duration: 1,
      ease: 'power1.inOut',
    });
  });
</script>
