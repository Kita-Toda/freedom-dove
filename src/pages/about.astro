---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="About Us — Unchained">
  <div class="min-h-screen bg-gradient-to-b from-black to-charcoal py-32 px-4 md:px-12">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-20">
        <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
          Our Story
        </div>
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-black text-cream leading-tight mb-8" style="letter-spacing: -0.02em;">
          About Unchained
        </h1>
        <p class="text-xl text-cream/80 max-w-2xl">
          A movement working to end human trafficking and modern slavery through rescue, advocacy, and awareness—in Australia and around the world.
        </p>
      </div>

      <!-- Mission Statement -->
      <section class="mb-20 border-t border-gold/20 pt-16">
        <div class="text-gold text-xs tracking-[0.08em] font-semibold opacity-80 mb-6">
          Our Mission
        </div>
        <h2 class="text-4xl font-bold text-cream mb-8">Ending Exploitation Worldwide</h2>
        <p class="text-lg text-cream/80 leading-relaxed mb-6">
          An estimated 49.6 million people are currently trapped in modern slavery—forced labor, debt bondage, child trafficking, and sexual exploitation. Unchained exists to help break those chains, working alongside rescue organisations, advocates, and survivors.
        </p>
        <p class="text-lg text-cream/80 leading-relaxed">
          We believe freedom is a fundamental right. We raise funds for frontline rescue, give survivors a platform to be heard, and work to confront the exploitation happening within Australia's own borders as well as overseas.
        </p>
      </section>

      <!-- Core Values -->
      <section class="mb-20 border-t border-gold/20 pt-16">
        <h2 class="text-4xl font-bold text-cream mb-12">Our Core Values</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-charcoal/50 border border-gold/30 rounded-2xl p-8">
            <Icon name="hand-raised" class="w-8 h-8 text-gold mb-4" />
            <h3 class="text-xl font-bold text-cream mb-3">Survivor-Centred</h3>
            <p class="text-cream/80">Survivors deserve not only justice but a platform to speak, heal and be remembered.</p>
          </div>

          <div class="bg-charcoal/50 border border-mauve/30 rounded-2xl p-8">
            <Icon name="sparkles" class="w-8 h-8 text-mauve-light mb-4" />
            <h3 class="text-xl font-bold text-cream mb-3">Faith-Driven</h3>
            <p class="text-cream/80">We believe this battle is both physical and spiritual, and we are called to bring light into the darkest places.</p>
          </div>

          <div class="bg-charcoal/50 border border-gold-light/30 rounded-2xl p-8">
            <Icon name="users" class="w-8 h-8 text-gold-light mb-4" />
            <h3 class="text-xl font-bold text-cream mb-3">Collaborative</h3>
            <p class="text-cream/80">No single organisation can end trafficking. We work alongside rescue organisations, law enforcement professionals, advocates and community leaders.</p>
          </div>

          <div class="bg-charcoal/50 border border-cream/30 rounded-2xl p-8">
            <Icon name="chart" class="w-8 h-8 text-cream mb-4" />
            <h3 class="text-xl font-bold text-cream mb-3">Accountable</h3>
            <p class="text-cream/80">Funds raised go to named rescue partners, and we tell supporters exactly what their giving made possible.</p>
          </div>
        </div>
      </section>

      <!-- What We Do -->
      <section class="mb-20 border-t border-gold/20 pt-16">
        <h2 class="text-4xl font-bold text-cream mb-12">What We Do</h2>

        <div class="space-y-12">
          <div class="relative pl-8 border-l-2 border-gold">
            <div class="absolute -left-4 -top-1 w-6 h-6 bg-gold rounded-full"></div>
            <h3 class="text-2xl font-bold text-gold mb-3">Funding Rescue</h3>
            <p class="text-cream/80 leading-relaxed">
              Through our galas and supporters, we raise funds that go directly to rescue operations—including the operation in the Philippines that brought nineteen children out of exploitation.
            </p>
          </div>

          <div class="relative pl-8 border-l-2 border-mauve">
            <div class="absolute -left-4 -top-1 w-6 h-6 bg-mauve rounded-full"></div>
            <h3 class="text-2xl font-bold text-mauve-light mb-3">A Platform for Survivors</h3>
            <p class="text-cream/80 leading-relaxed">
              Our events bring survivors, advocates and frontline operators onto the same stage—so that those who were trafficked, abused, bought and sold are finally heard.
            </p>
          </div>

          <div class="relative pl-8 border-l-2 border-gold-light">
            <div class="absolute -left-4 -top-1 w-6 h-6 bg-gold-light rounded-full"></div>
            <h3 class="text-2xl font-bold text-gold-light mb-3">Frontline Partnerships</h3>
            <p class="text-cream/80 leading-relaxed">
              We work alongside rescue organisations, frontline operators, and law enforcement professionals—including partners such as Destiny Rescue and Freedom for Humanity—so that funds raised reach the operations that bring children home.
            </p>
          </div>

          <div class="relative pl-8 border-l-2 border-cream">
            <div class="absolute -left-4 -top-1 w-6 h-6 bg-cream rounded-full"></div>
            <h3 class="text-2xl font-bold text-cream mb-3">Awareness & Education</h3>
            <p class="text-cream/80 leading-relaxed">
              Through film, campaigns and community conversations, we help young people, parents and the wider public recognise grooming, exploitation and the warning signs—including in online gaming, where children connect every day.
            </p>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="mb-20 border-t border-gold/20 pt-16">
        <h2 class="text-4xl font-bold text-cream mb-12">By The Numbers</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-charcoal/50 border border-gold/30 rounded-2xl p-12 text-center">
            <div class="text-4xl sm:text-5xl font-black text-gold mb-2">50</div>
            <div class="text-cream/80 text-sm tracking-wide font-semibold">Children Freed</div>
          </div>

          <div class="bg-charcoal/50 border border-mauve/30 rounded-2xl p-12 text-center">
            <div class="text-4xl sm:text-5xl font-black text-mauve-light mb-2">19</div>
            <div class="text-cream/80 text-sm tracking-wide font-semibold">Rescued in a Single Operation</div>
          </div>

          <div class="bg-charcoal/50 border border-gold-light/30 rounded-2xl p-12 text-center">
            <div class="text-4xl sm:text-5xl font-black text-gold-light mb-2">$170K+</div>
            <div class="text-cream/80 text-sm tracking-wide font-semibold">Raised for Rescue Efforts</div>
          </div>

          <div class="bg-charcoal/50 border border-cream/30 rounded-2xl p-12 text-center">
            <div class="text-4xl sm:text-5xl font-black text-cream mb-2">4</div>
            <div class="text-cream/80 text-sm tracking-wide font-semibold">Unchained Galas Hosted</div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="border-t border-gold/20 pt-16 text-center">
        <h2 class="text-4xl font-bold text-cream mb-8">Join the Movement</h2>
        <p class="text-lg text-cream/80 mb-8 max-w-2xl mx-auto">
          Freedom is not a luxury—it's a right. Every person, organization, and government can play a role in ending slavery.
        </p>
        <a href="/get-involved" class="inline-block px-12 py-5 bg-gold text-black font-bold rounded-full hover:scale-[1.02] transition-transform duration-200 text-sm tracking-[0.75px]">
          Get Involved
        </a>
      </section>
    </div>
  </div>
</Layout>
